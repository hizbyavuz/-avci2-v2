FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
RUN pip install --no-cache-dir gunicorn==26.2.0
COPY ta_paper /app/ta_paper
USER 10001:10001
EXPOSE 8443
CMD ["gunicorn", "--bind", "0.0.0.0:8443", "--workers", "1", "--threads", "1", "--worker-class", "sync", "--timeout", "25", "--backlog", "32", "--limit-request-line", "2048", "--limit-request-fields", "20", "--limit-request-field_size", "4096", "--certfile", "/tls/server.crt", "--keyfile", "/tls/server.key", "ta_paper.egress:create_app()"]
