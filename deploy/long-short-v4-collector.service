[Unit]
Description=Long/Short V4 Binance Futures read-only continuous native stream collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tradeobserver
Group=tradeobserver
WorkingDirectory=/srv/avci
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/avci/.venv/bin/python -u /srv/avci/long_short_v4_native_pipeline.py --db /var/lib/avci/long_short_v4_native.db --analyst-db /var/lib/avci/long_short_v31_analyst.db --symbols BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT --seconds 3600 --report /var/lib/avci/v4_collection.json
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/avci
PrivateTmp=true
PrivateDevices=true
UMask=0077

[Install]
WantedBy=multi-user.target
